@page
@model HealthApp.Razor.Pages.AdminModel
@{
}
<h1>Admin</h1>
<p>The code is @Model.UserId</p>
<p>The user is @User.Identity.Name</p>

<ul>
    @foreach (var item in User.Claims)
    {
        <li>@item</li>
    })
</ul>

<table class="table">
    <h2>Doctor List</h2>
    <thead>
        <tr><th>Id</th><th>Name</th><th>Last Name</th><th>Email</th></tr>
    </thead>
    <tbody>
        @foreach (var doctor in Model.Doctors)
        {
            <tr>
                <td>@doctor.Id</td>
                <td>@doctor.FirstName</td>
                <td>@doctor.LastName</td>
                <td>@doctor.Email</td>
            </tr>
        }
    </tbody>
</table>

<table class="table">
    <h2>Patient List</h2>
    <thead>
        <tr><th>Id</th><th>Name</th><th>Last Name</th><th>Email</th></tr>
    </thead>
    <tbody>
        @foreach (var patient in Model.Patients)
        {
            <tr>
                <td>@patient.Id</td>
                <td>@patient.FirstName</td>
                <td>@patient.LastName</td>
                <td>@patient.Email</td>
            </tr>
        }
    </tbody>
</table>